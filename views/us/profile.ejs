        async function addNewSkill() {
            const name = document.getElementById('skill-name').value.trim();
            const icon = document.getElementById('skill-icon').value.trim();
            if (!name && !name) {
                alert('Vui lòng nhập ít nhất một trường');
                return;
            }
            try {
                const res = await fetch('/profile/skill/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        name,
                        icon
                    })
                });

                const data = await res.json();

                if (data.success) {
                    document.getElementById('skill-name').value = '';
                    document.getElementById('skill-icon').value = '';
                    alert('Thêm kỹ năng thành công');
                    closeSkillModal();
                    reloadSkillList();
                } else {
                    alert(data.message || 'Thêm thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }

        async function addNewHobby() {
            const title = document.getElementById('hobby-title').value.trim();
            const content = document.getElementById('hobby-content').value.trim();
            const icon = document.getElementById('hobby-icon').value.trim();

            if (!title && !content && !icon) {
                alert('Vui lòng nhập ít nhất một trường');
