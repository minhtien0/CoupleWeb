                                <div class="text-lg mb-1">🎬</div>
                                <div class="text-xs">Giải trí</div>
                            </button>
                                <button type="button" onclick="selectExpenseCategory('Di chuyển')" class="expense-category-btn p-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-center">
                                <div class="text-lg mb-1">🚗</div>
                                <div class="text-xs">Di chuyển</div>
                            </button>
                                <button type="button" onclick="selectExpenseCategory('Mua sắm')" class="expense-category-btn p-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-center">
