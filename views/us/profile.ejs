                const data = await res.json();

                if (data.success) {
                    document.getElementById('hobby-title').value = '';
                    document.getElementById('hobby-content').value = '';
                    document.getElementById('hobby-icon').value = '';
                    alert('Thêm thành công');
                    closeHobbyModal();
                    reloadHobbyList();
                } else {
                    alert(data.message || 'Thêm thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }
        async function addNewEdu() {
            const school = document.getElementById('edu-name').value.trim();
            const major = document.getElementById('edu-major').value.trim();
            const year = document.getElementById('edu-year').value.trim();

            if (!school && !major && !year) {
                alert('Vui lòng nhập ít nhất một trường');
                return;
            }

            try {
                const res = await fetch('/profile/education/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        school,
                        major,
                        year
                    })
                });

                const data = await res.json();

                if (data.success) {
                    document.getElementById('edu-name').value = '';
                    document.getElementById('edu-major').value = '';
                    document.getElementById('edu-year').value = '';
                    alert('Thêm thành công');
                    closeEduModal();
                    reloadEduList();
                } else {
                    alert(data.message || 'Thêm thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }

        async function updateAbout() {
            const content = document.getElementById('about-me').value.trim();
            if (!content) {
                alert('Vui lòng nhập nội dung');
                return;
            }
            try {
                const res = await fetch('/profile/about/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        content
                    })
                });

                const data = await res.json();

                if (data.success) {
                    document.getElementById('about-me').value = '';
                    alert('Sửa thành công');
                    location.reload();
                } else {
                    alert(data.message || 'Thêm thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }

        function closeSkillModal() {
            document.getElementById('skill-modal').classList.add('hidden');
        }

        function closeHobbyModal() {
            document.getElementById('hobby-modal').classList.add('hidden');
        }

        function closeEduModal() {
            document.getElementById('edu-modal').classList.add('hidden');
        }

        function closeInterestModal() {
            document.getElementById('interest-modal').classList.add('hidden');
        }

        async function addNewInterest() {
            const name = document.getElementById('interest-name').value.trim();
            const icon = document.getElementById('interest-icon').value.trim();
            if (!name && !name) {
                alert('Vui lòng nhập ít nhất một trường');
                return;
            }
            try {
                const res = await fetch('/profile/interest/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        name,
                        icon
                    })
                });

                const data = await res.json();

                if (data.success) {
                    document.getElementById('interest-name').value = '';
                    document.getElementById('interest-icon').value = '';
                    alert('Thêm yêu thích thành công');
                    closeInterestModal();
                    reloadInterestList();
                } else {
                    alert(data.message || 'Thêm thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
