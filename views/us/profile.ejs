    <script>
        function goBack() {
            alert('Quay lại trang trước');
        }

        async function logout() {
            try {
                const res = await fetch("/logout", {
                    method: "POST",
                    credentials: "include"
                });
                const data = await res.json();
                if (data.success) {
                    alert("Đã đăng xuất");
                    window.location.href = "/";
                } else {
                    alert(data.message || "Logout thất bại");
                }
            } catch (err) {
                console.error(err);
                alert("Có lỗi xảy ra khi logout");
            }
        }


        async function changePassword() {
            const oldPassword = document.getElementById('old-password').value.trim();
            const newPassword = document.getElementById('new-password').value.trim();
            const confirmPassword = document.getElementById('confirm-password').value.trim();

            if (!oldPassword || !newPassword || !confirmPassword) {
                return alert('Vui lòng nhập đầy đủ thông tin');
            }

            if (newPassword !== confirmPassword) {
                return alert('Mật khẩu xác nhận không khớp');
            }

            try {
                const res = await fetch('/profile/password/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        oldPassword,
                        newPassword
                    })
                });

                const data = await res.json();

                if (data.success) {
                    alert('Đổi mật khẩu thành công');
                    document.getElementById('old-password').value = '';
                    document.getElementById('new-password').value = '';
                    document.getElementById('confirm-password').value = '';
                } else {
                    alert(data.message || 'Đổi mật khẩu thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }


        async function saveProfile() {
            const name = document.getElementById('display-name').value.trim();
            const age = document.getElementById('birth-date').value;
            const gender = document.getElementById('gender').value;

            if (!name) {
                alert('Tên không được để trống');
                return;
            }

            if (!age) {
                alert('Vui lòng chọn ngày sinh');
                return;
            }

            try {
                const res = await fetch('/profile/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        name,
                        age,
                        gender
                    })
                });

                const data = await res.json();

                if (data.success) {
                    alert('✅ Lưu hồ sơ thành công');
                    location.reload();
                } else {
                    alert(data.message || '❌ Lưu thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }

        function changeAvatar() {
            document.getElementById('avatarInput').click();
        }

        document.getElementById('avatarInput').addEventListener('change', async function() {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('avatar', file);

            try {
                const res = await fetch('/update-avatar', {
                    method: 'POST',
                    body: formData
                });

                if (res.ok) {
                    location.reload();
                } else {
                    alert('Upload avatar thất bại');
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi xảy ra');
            }
        });

        let isEditingBasic = false;

        function toggleEditBasic() {
            isEditingBasic = !isEditingBasic;

            document.querySelectorAll('#basic-info input, #basic-info select, #basic-info textarea')
                .forEach(el => el.disabled = !isEditingBasic);

            document.getElementById('basic-save').classList.toggle('hidden', !isEditingBasic);
        }

        async function saveBasicInfo() {
            const data = {
                age: document.getElementById('birth-date').value,
                height: document.getElementById('height').value,
                zodiac: document.getElementById('zodiac').value,
                mbti: document.getElementById('mbti').value,
                address: document.getElementById('address').value
            };

            try {
                const res = await fetch('/profile/basic/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await res.json();

                if (result.success) {
                    alert('✅ Cập nhật thành công');
                    location.reload();
                } else {
                    alert(result.message || '❌ Lỗi');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối server');
            }
        }

        function addSkill() {
            document.getElementById('skill-modal').classList.remove('hidden');
        }

        function addHobby() {
            document.getElementById('hobby-modal').classList.remove('hidden');
        }

        function addEdu() {
            document.getElementById('edu-modal').classList.remove('hidden');
        }

        function addInterest() {
            document.getElementById('interest-modal').classList.remove('hidden');
        }
        async function reloadSkillList() {
            const res = await fetch('/profile/skill/partial');
            const html = await res.text();
            document.getElementById('skills-list').innerHTML = html;
        }
