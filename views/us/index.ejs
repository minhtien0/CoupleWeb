                    <% getCost.forEach(item => { %>
                        <% 
            // Format ngày trong EJS
            const d = new Date(item.date_time);
            const formattedDate = ("0" + d.getDate()).slice(-2) + "/" +
                                  ("0" + (d.getMonth() + 1)).slice(-2) + "/" +
                                  d.getFullYear();
        %>

