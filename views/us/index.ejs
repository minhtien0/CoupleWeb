                                    <% } %>

            </div>

            <button onclick="addExpense()" class="w-full mt-4 border-2 border-indigo-200 text-indigo-600 py-3 rounded-xl font-medium hover:bg-indigo-50 transition-colors">
                + Thêm chi phí
            </button>
