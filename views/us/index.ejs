                    </div>
                </div>

                <!-- Edit Profile Button -->
                <button class="w-full bg-gradient-to-r from-indigo-400 to-purple-400 text-white py-3 rounded-xl font-medium hover:shadow-lg transition-all">
                    ✏️ Thống kê chi tiết
