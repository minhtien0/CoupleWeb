<!-- Goal Detail Modal -->
<div id="goal-detail-modal" class="fixed inset-0 bg-black/40 hidden z-30 overflow-y-auto">
    <div class="flex items-start sm:items-center justify-center min-h-screen p-4 py-8">
        <div class="bg-white max-w-md w-full rounded-2xl shadow-lg max-h-[90vh] flex flex-col">

            <!-- Header - Fixed -->
            <div class="p-6 pb-4 flex-shrink-0">
                <h2 class="text-xl font-semibold" id="g-title"></h2>
                <p class="text-gray-600 mt-2" id="g-desc"></p>
                <p class="text-sm text-gray-500 mt-1">
                    <span id="g-date"></span>
                </p>
                <p class="text-sm text-gray-500 mt-1">
                    <span id="e-date"></span>
                </p>

                <!-- progress -->
                <div class="mt-3">
                    <span id="g-progress-text" class="text-sm font-medium"></span>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div id="g-progress-bar" class="bg-green-500 h-2 rounded-full"></div>
                    </div>
                </div>
            </div>

            <!-- Scrollable Content -->
            <div class="px-6 overflow-y-auto flex-1">
                <!-- LOG LIST -->
                <div class="max-h-48 overflow-y-auto border p-3 rounded-lg mb-4" id="g-logs">
                    Loading...
                </div>

                <!-- Check-in Form -->
                <form id="checkin-form" class="space-y-4">
                    <input type="hidden" id="checkin-goal-id" name="goal_id">

                    <div>
                        <label class="text-sm font-medium mb-1 block">Ghi chú</label>
                        <textarea name="note" class="w-full border rounded-lg p-2" rows="3"></textarea>
                    </div>

                    <div>
                        <label class="text-sm font-medium block mb-2">Ảnh</label>
                        <input type="file" name="image" accept="image/*" capture="environment" class="w-full text-sm">
                    </div>

                    <button type="submit" class="w-full bg-green-500 text-white p-3 rounded-xl hover:bg-green-600 transition-colors">
                        Điểm danh
                    </button>
                </form>
            </div>

            <!-- Footer - Fixed -->
            <div class="p-6 pt-4 flex-shrink-0 border-t border-gray-100">
                <button onclick="closeGoalDetail()" class="w-full py-3 text-gray-600 hover:text-gray-800 font-medium transition-colors">
                    Đóng
                </button>
            </div>

        </div>
    </div>
</div>