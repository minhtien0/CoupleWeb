    <!-- Success Animation Overlay -->
    <div id="success-overlay" class="fixed inset-0 bg-gradient-to-br from-pink-500/90 to-purple-500/90 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="text-center text-white animate-slideInUp">
            <div class="text-6xl sm:text-8xl mb-4 sm:mb-6 animate-hearts">💕</div>
            <h2 class="text-3xl sm:text-4xl font-bold mb-3 sm:mb-4">Chúc mừng!</h2>
            <p class="text-lg sm:text-xl mb-6 sm:mb-8 px-4">Bạn đã tham gia Couple App thành công</p>
            <div class="loading-dots text-xl sm:text-2xl">Đang chuyển hướng</div>
        </div>
    </div>
    <script>
        // State management
        let currentStep = 1;
        let selectedChoice = null;
        let generatedCode = 'LOVE2025';

        const userData = {
            displayName: '',
            birthday: '',
            gender: '',
            email: '',
            password: '',
            coupleCode: ''
        };

        // Step navigation
        function goToStep(step) {
            // Hide all steps
            document.querySelectorAll('[id^="step-"]').forEach(el => {
                el.classList.add('hidden');
            });

            // Show target step
            document.getElementById(`step-${step}`).classList.remove('hidden');

            // Update step indicators
            updateStepIndicators(step);
            currentStep = step;
        }

        function updateStepIndicators(activeStep) {
            const indicators = document.querySelectorAll('.step-indicator');
            indicators.forEach((indicator, index) => {
                const stepNumber = index + 1;
                if (stepNumber <= activeStep) {
                    indicator.classList.add('active');
                } else {
                    indicator.classList.remove('active');
                }
            });
        }


        function selectChoice(choice) {
            selectedChoice = choice;

            if (choice === 'create') {
                document.getElementById('step-2-title').textContent = 'Tạo hồ sơ cá nhân';
                document.getElementById('step-2-subtitle').textContent = 'Điền thông tin để tạo tài khoản couple';
                document.getElementById('couple-code-section').classList.add('hidden');
                document.getElementById('create-code-section').classList.remove('hidden');
                document.getElementById('join-code-section').classList.add('hidden');
            } else if (choice === 'join') {
                document.getElementById('step-2-title').textContent = 'Tham gia bằng mã couple';
                document.getElementById('step-2-subtitle').textContent = 'Nhập thông tin để tham gia couple';
                document.getElementById('couple-code-section').classList.remove('hidden');
                document.getElementById('create-code-section').classList.add('hidden');
                document.getElementById('join-code-section').classList.remove('hidden');
            }

            goToStep(2);
        }


        function validateStep2() {
            const requiredFields = ['display-name', 'birthday', 'gender', 'email', 'password'];
            let isValid = true;

            requiredFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (!field.value.trim()) {
                    field.classList.add('border-red-500');
                    isValid = false;
                } else {
                    field.classList.remove('border-red-500');
                }
            });

            if (selectedChoice === 'join') {
                const coupleCodeField = document.getElementById('couple-code');
                if (!coupleCodeField.value.trim()) {
                    coupleCodeField.classList.add('border-red-500');
                    isValid = false;
                } else {
                    coupleCodeField.classList.remove('border-red-500');
                }
            }

            if (!isValid) {
                alert('Vui lòng điền đầy đủ thông tin bắt buộc!');
                return false;
            }

            // Validate email
            const email = document.getElementById('email').value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                document.getElementById('email').classList.add('border-red-500');
                alert('Email không hợp lệ!');
                return false;
            }

            // Validate password
            const password = document.getElementById('password').value;
            if (password.length < 6) {
                document.getElementById('password').classList.add('border-red-500');
                alert('Mật khẩu phải có ít nhất 6 ký tự!');
                return false;
            }

            return true;
        }

        // Code generation and management
        function generateCoupleCode() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let result = '';
            for (let i = 0; i < 8; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            generatedCode = result;
            document.getElementById('generated-code').textContent = result;
        }

        function copyCode() {
            navigator.clipboard.writeText(generatedCode).then(() => {
                const button = event.target;
                const originalText = button.textContent;
                button.textContent = '✅ Đã copy!';
                setTimeout(() => {
                    button.textContent = originalText;
                }, 2000);
            });
        }

        function shareCode() {
            if (navigator.share) {
                navigator.share({
                    title: 'Couple App - Mã kết nối',
                    text: `Hãy tải Couple App và sử dụng mã: ${generatedCode} để kết nối với tôi! 💕`,
                    url: window.location.origin
                });
            } else {
                copyCode();
                alert('Mã đã được copy! Hãy chia sẻ cho người yêu của bạn 💕');
            }
        }

        function joinCouple() {
            const code = document.getElementById('join-couple-code').value.trim().toUpperCase();

            if (!code) {
                alert('Vui lòng nhập mã couple!');
                return;
            }

            if (code.length !== 8) {
                alert('Mã couple phải có 8 ký tự!');
                return;
            }

            // Simulate API call to join couple
            const button = event.target;
            const originalText = button.textContent;
            button.textContent = '🔄 Đang kết nối...';
            button.disabled = true;

            setTimeout(() => {
                // Simulate successful connection
                document.getElementById('join-code-section').classList.add('hidden');
                document.getElementById('connection-status').classList.remove('hidden');
                button.textContent = originalText;
                button.disabled = false;
            }, 60000);
        }

        // Auth functions
        function showLoginForm() {
            // Hide step indicators and all steps
            document.getElementById('step-indicators').classList.add('hidden');
            document.querySelectorAll('[id^="step-"]').forEach(el => {
                el.classList.add('hidden');
            });

            // Show login form
            document.getElementById('fogot-password-form').classList.add('hidden');
            document.getElementById('login-form').classList.remove('hidden');
        }

        function showFogotPasswordForm(){
            document.getElementById('step-indicators').classList.add('hidden');
            document.querySelectorAll('[id^="step-"]').forEach(el => {
                el.classList.add('hidden');
            });
            document.getElementById('login-form').classList.add('hidden');
            document.getElementById('fogot-password-form').classList.remove('hidden');
        }


        function showRegister() {
            // Show step indicators and go to step 1
            document.getElementById('step-indicators').classList.remove('hidden');
            document.getElementById('login-form').classList.add('hidden');
            document.getElementById('fogot-password-form').classList.add('hidden');
            goToStep(1);
        }

        function login(event) {
            if (event) event.preventDefault();
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value.trim();
            const errorElement = document.getElementById('login-error');
            const button = document.getElementById('login-btn');
            const originalText = button.textContent;
            if (errorElement) errorElement.textContent = '';
            // 1. Kiểm tra không bỏ trống (KHÔNG thay đổi nút ở đây)
            if (!email || !password) {
                if (errorElement) errorElement.textContent = 'Vui lòng nhập email và mật khẩu!';
                console.log('Validation fail: Missing fields');
                return;
            }
            // 2. Hiệu ứng loading CHỈ khi validation pass (gửi request hợp lệ)
            button.textContent = '🔄 Đang đăng nhập...';
            button.disabled = true;
            // 3. Gửi AJAX request
            fetch('/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        email,
                        password
                    })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showSuccessOverlay();
                        setTimeout(() => {
                            window.location.href = data.redirect; 
                        }, 3000);
                    } else {
                        if (errorElement) errorElement.textContent = data.message || 'Email hoặc mật khẩu không đúng!';
                        button.textContent = originalText;
                        button.disabled = false;
                    }
                })
                .catch(err => {
                    console.error('Lỗi:', err);
                    if (errorElement) errorElement.textContent = 'Không thể kết nối tới server!';
                    button.textContent = originalText;
                    button.disabled = false;
                });
        }

        let currentVerificationFlow = 'register';
        async function fotgotPassword(e) {
    e.preventDefault();

    const email = document.getElementById("forgot-email").value.trim();
    const errorEl = document.getElementById("fogot-password-error");
    const btn = document.getElementById("forgot-btn"); // ← đổi id đúng

    errorEl.textContent = "";

    if (!email) {
        errorEl.textContent = "Vui lòng nhập email!";
        return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        errorEl.textContent = "Email không hợp lệ!";
        return;
    }

    btn.disabled = true;
    btn.textContent = "🔄 Đang gửi...";

    try {
        const res = await fetch("/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email })
        });

        const data = await res.json();

        if (!data.success) {
            errorEl.textContent = data.message || "Email không tồn tại trong hệ thống!";
            btn.disabled = false;
            btn.textContent = "Gửi mật khẩu mới";
            return;
        }

        userEmail = email;
        btn.disabled = false;
        btn.textContent = "Gửi mật khẩu mới";
        currentVerificationFlow = 'forgot';
        // Hiện modal NHƯNG không start interval register
        showVerificationModalOnly(email);

        // Start interval riêng cho forgot password
        startForgotPasswordVerificationCheck(email);

    } catch (err) {
        console.error(err);
        errorEl.textContent = "Không kết nối được server!";
        btn.disabled = false;
        btn.textContent = "Gửi mật khẩu mới";
    }
}

// Chỉ hiện modal + countdown, KHÔNG gọi startVerificationCheck của register
function showVerificationModalOnly(email) {
    const modal = document.getElementById("verification-modal");
    const userEmailSpan = document.getElementById("user-email");

    userEmailSpan.textContent = email;
    modal.classList.remove("hidden");

    // Reset trạng thái modal
    document.getElementById("verification-status").classList.remove("hidden");
    document.getElementById("success-message").classList.add("hidden");
    document.getElementById("expired-message").classList.add("hidden");
    document.getElementById("resend-email").disabled = false;

    startCountdown();
    // Không gọi startVerificationCheck ở đây
}

function startForgotPasswordVerificationCheck(email) {
    clearInterval(verificationCheckInterval);

    verificationCheckInterval = setInterval(async () => {
        try {
            // Gọi endpoint riêng cho forgot password
            const res = await fetch(`/check-reset-verification?email=${encodeURIComponent(email)}`);
            const data = await res.json();

            if (data.verified) {
                clearInterval(verificationCheckInterval);
                clearInterval(countdownInterval);
                showSuccessMessage();

                setTimeout(() => {
                    window.location.href = "/"; // về trang login
                }, 2000);
            }
        } catch (err) {
            console.error("Lỗi kiểm tra xác thực forgot password:", err);
        }
    }, 2000);
}

       
        let countdownInterval = null;
        let verificationCheckInterval = null;
        let userEmail = '';
        let currentToken = '';

        document.getElementById("personal-form").addEventListener("submit", async function(e) {
            e.preventDefault();

            const formError = document.getElementById("form-error");
            formError.textContent = "";

            const submitBtn = document.getElementById("submit-btn");
            submitBtn.disabled = true;
            submitBtn.textContent = "Đang xử lý...";

            const dataRegister = {
                displayName: document.getElementById("display-name").value,
                birthday: document.getElementById("birthday").value,
                gender: document.getElementById("gender").value,
                email: document.getElementById("email").value,
                password: document.getElementById("password").value
            };

            userEmail = dataRegister.email;

            try {
                const res = await fetch("/register", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(dataRegister)
                });

                const data = await res.json();

                if (!res.ok) {
                    formError.textContent = data.message || "Có lỗi xảy ra!";
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Tiếp tục →";
                    return;
                }
                showVerificationModal(dataRegister.email);

            } catch (err) {
                console.error(err);
                formError.textContent = "Không thể kết nối tới server!";
                submitBtn.disabled = false;
                submitBtn.textContent = "Tiếp tục →";
            }
        });

        function showVerificationModal(email) {
            currentVerificationFlow = 'register';
            const modal = document.getElementById("verification-modal");
            const userEmailSpan = document.getElementById("user-email");

            userEmailSpan.textContent = email;
            modal.classList.remove("hidden");

            // Bắt đầu đếm ngược
            startCountdown();

            // Bắt đầu kiểm tra trạng thái xác thực
            startVerificationCheck(email);
        }

        function startCountdown() {
            let timeLeft = 60;
            const countdownElement = document.getElementById("countdown");
            const progressCircle = document.getElementById("progress-circle");
            const circumference = 565.48; // 2 * PI * radius (90)

            clearInterval(countdownInterval);

            countdownInterval = setInterval(() => {
                timeLeft--;
                countdownElement.textContent = timeLeft;

                // Update progress circle
                const progress = (timeLeft / 60) * circumference;
                progressCircle.style.strokeDashoffset = circumference - progress;

                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                    showExpiredMessage();
                }
            }, 1000);
        }

        function startVerificationCheck(email) {
            clearInterval(verificationCheckInterval);

            verificationCheckInterval = setInterval(async() => {
                try {
                    const res = await fetch(`/check-verification?email=${encodeURIComponent(email)}`);
                    const data = await res.json();

                    if (data.verified) {
                        clearInterval(verificationCheckInterval);
                        clearInterval(countdownInterval);
                        showSuccessMessage();

                        // Chuyển hướng sau 2 giây
                        setTimeout(() => {
                            window.location.href = "/";
                        }, 2000);
                    }
                } catch (err) {
                    console.error("Lỗi kiểm tra xác thực:", err);
                }
            }, 2000); // Kiểm tra mỗi 2 giây
        }

        function showSuccessMessage() {
            document.getElementById("verification-status").classList.add("hidden");
            document.getElementById("expired-message").classList.add("hidden");
            document.getElementById("success-message").classList.remove("hidden");
            document.getElementById("resend-email").disabled = true;
        }

        function showExpiredMessage() {
            document.getElementById("verification-status").classList.add("hidden");
            document.getElementById("success-message").classList.add("hidden");
            document.getElementById("expired-message").classList.remove("hidden");
            document.getElementById("resend-email").disabled = false;
        }

        // Gửi lại email
        document.getElementById("resend-email").addEventListener("click", async function() {
    const btn = this;
    btn.disabled = true;
    btn.textContent = "Đang gửi...";

    // Chọn endpoint theo flow
    const endpoint = currentVerificationFlow === 'forgot' 
        ? "/resend-verification-forgot" 
        : "/resend-verification";

    try {
        const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: userEmail })
        });

        const data = await res.json();

        if (res.ok) {
            document.getElementById("expired-message").classList.add("hidden");
            document.getElementById("verification-status").classList.remove("hidden");
            startCountdown();

            // Start đúng interval theo flow
            if (currentVerificationFlow === 'forgot') {
                startForgotPasswordVerificationCheck(userEmail);
            } else {
                startVerificationCheck(userEmail);
            }

            btn.textContent = "📧 Gửi lại email";
        } else {
            alert(data.message || "Không thể gửi lại email!");
            btn.disabled = false;
            btn.textContent = "📧 Gửi lại email";
        }
    } catch (err) {
        console.error(err);
        alert("Có lỗi xảy ra!");
        btn.disabled = false;
        btn.textContent = "📧 Gửi lại email";
    }
});

        // Đóng modal
        document.getElementById("close-modal").addEventListener("click", function() {
            clearInterval(countdownInterval);
            clearInterval(verificationCheckInterval);
            document.getElementById("verification-modal").classList.add("hidden");

            // Reset form
            document.getElementById("submit-btn").disabled = false;
            document.getElementById("submit-btn").textContent = "Tiếp tục →";
        });

        // Registration flow
        function completeRegistration() {
            // Collect user data
            userData.displayName = document.getElementById('display-name').value;
            userData.birthday = document.getElementById('birthday').value;
            userData.gender = document.getElementById('gender').value;
            userData.email = document.getElementById('email').value;
            userData.password = document.getElementById('password').value;

            if (selectedChoice === 'join') {
                userData.coupleCode = document.getElementById('couple-code').value;
            }

            // Simulate registration API call
            const button = event.target;
            const originalText = button.textContent;
            button.textContent = '🔄 Đang tạo tài khoản...';
            button.disabled = true;

            setTimeout(() => {
                showSuccessOverlay();
                setTimeout(() => {
                    window.location.href = '/matching'; // Redirect to matching page 
                }, 3000);
            }, 2000);
        }

        function skipConnection() {
            // Allow user to skip couple connection and use app solo
            if (confirm('Bạn có thể kết nối với người yêu sau này. Tiếp tục tạo tài khoản cá nhân?')) {
                completeRegistration();
            }
        }

        // UI effects
        function showSuccessOverlay() {
            document.getElementById('success-overlay').classList.remove('hidden');
        }

        function showTerms() {
            alert('Điều khoản sử dụng:\n\n• Ứng dụng dành cho người trên 18 tuổi\n• Không chia sẻ thông tin cá nhân với bên thứ 3\n• Tôn trọng quyền riêng tư của đối phương\n• Sử dụng ứng dụng một cách tích cực');
        }

        function showPrivacy() {
            alert('Chính sách bảo mật:\n\n• Dữ liệu được mã hóa end-to-end\n• Không thu thập thông tin không cần thiết\n• Người dùng có quyền xóa dữ liệu\n• Tuân thủ GDPR và các quy định về bảo mật');
        }

        // Auto-formatting for couple code inputs
        function setupCodeInputs() {
            const codeInputs = document.querySelectorAll('#couple-code, #join-couple-code');
            codeInputs.forEach(input => {
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/[^A-Z0-9]/g, '').substring(0, 8);
                });

                input.addEventListener('keyup', function() {
                    this.value = this.value.toUpperCase();
                });
            });
        }

        // Enhanced step 2 navigation with validation
        document.addEventListener('DOMContentLoaded', function() {
            // Override the step 3 navigation button
            const step2ContinueBtn = document.querySelector('#step-2 button[onclick="goToStep(3)"]');
            if (step2ContinueBtn) {
                step2ContinueBtn.onclick = function() {
                    if (validateStep2()) {
                        goToStep(3);

                        // Generate new couple code if creating
                        if (selectedChoice === 'create') {
                            generateCoupleCode();
                            // Simulate waiting for partner
                            simulatePartnerConnection();
                        }
                    }
                };
            }

            // Setup code input formatting
            setupCodeInputs();

            // Add real-time validation
            const inputs = document.querySelectorAll('input, select');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value.trim()) {
                        this.classList.remove('border-red-500');
                        this.classList.add('border-green-500');
                    }
                });

                input.addEventListener('focus', function() {
                    this.classList.remove('border-red-500', 'border-green-500');
                });
            });
        });

        // Simulate partner connection process
        function simulatePartnerConnection() {
            if (selectedChoice === 'create') {
                // Simulate random connection after 5-15 seconds
                const connectionTime = Math.random() * 10000 + 5000;
                setTimeout(() => {
                    if (Math.random() > 0.3) { // 70% success rate
                        // Success case
                        document.getElementById('create-code-section').classList.add('hidden');
                        document.getElementById('connection-status').classList.remove('hidden');
                    } else {
                        // Still waiting case
                        const loadingText = document.querySelector('.loading-dots');
                        loadingText.textContent = 'Vẫn đang chờ kết nối...';

                        // Add helpful message
                        const helpDiv = document.createElement('div');
                        helpDiv.className = 'text-center mt-4';
                        helpDiv.innerHTML = `
                            <p class="text-sm text-gray-600 mb-2">Mất nhiều thời gian hơn dự kiến?</p>
                            <button onclick="resendCode()" class="text-pink-600 text-sm font-medium hover:underline">
                                📤 Gửi lại mã
                            </button>
                        `;
                        document.getElementById('create-code-section').appendChild(helpDiv);
                    }
                }, connectionTime);
            }
        }

        function resendCode() {
            alert('Mã couple đã được gửi lại qua:\n\n📧 Email\n📱 SMS\n💬 Các ứng dụng nhắn tin\n\nHãy kiểm tra và chia sẻ với người yêu!');
        }


        // Demo data for testing
        function fillDemoData() {
            document.getElementById('display-name').value = 'An';
            document.getElementById('birthday').value = '2001-03-15';
            document.getElementById('gender').value = 'female';
            document.getElementById('email').value = 'an@example.com';
            document.getElementById('password').value = 'password123';

            if (selectedChoice === 'join') {
                document.getElementById('couple-code').value = 'DEMO2024';
            }
        }

        // Easter egg - konami code for demo data
        let konamiCode = [];
        const konamiSequence = [38, 38, 40, 40, 37, 39, 37, 39, 66, 65]; // ↑↑↓↓←→←→BA

        document.addEventListener('keydown', function(e) {
            konamiCode.push(e.keyCode);
            if (konamiCode.length > konamiSequence.length) {
                konamiCode.shift();
            }

            if (JSON.stringify(konamiCode) === JSON.stringify(konamiSequence)) {
                fillDemoData();
                alert('🎮 Demo data loaded! Konami code activated!');
                konamiCode = [];
            }
        });

        // Accessibility enhancements
        document.addEventListener('DOMContentLoaded', function() {
            // Add ARIA labels
            const inputs = document.querySelectorAll('input, select');
            inputs.forEach(input => {
                const label = input.previousElementSibling;
                if (label && label.tagName === 'LABEL') {
                    input.setAttribute('aria-describedby', input.id + '-help');
                }
            });

            // Add keyboard navigation for steps
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && e.target.tagName === 'BUTTON') {
                    e.target.click();
                }
            });
        });

        // Performance optimization
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Add debounced validation for real-time feedback
        const debouncedValidation = debounce(function(input) {
            if (input.value.trim()) {
                // Show success state
                input.classList.remove('border-red-500');
                input.classList.add('border-green-300');
            }
        }, 500);

        // Apply to all inputs
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('input');
            inputs.forEach(input => {
                input.addEventListener('input', () => debouncedValidation(input));
            });
        });

        // Analytics simulation (for future implementation)
        function trackEvent(eventName, properties = {}) {
            console.log(`Analytics Event: ${eventName}`, properties);
            // In real app, this would send to analytics service
        }

        // Track user journey
        function trackStep(stepNumber) {
            trackEvent('auth_step_completed', {
                step: stepNumber,
                choice: selectedChoice,
                timestamp: new Date().toISOString()
            });
        }

        // Override goToStep to include tracking
        const originalGoToStep = goToStep;
        goToStep = function(step) {
            originalGoToStep(step);
            trackStep(step);
        };
    </script>
</body>

</html>