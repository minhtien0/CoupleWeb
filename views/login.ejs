<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Couple App - Đăng nhập</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sans': ['Inter', 'system-ui', 'sans-serif']
                    },
                    animation: {
                        'float': 'float 3s ease-in-out infinite',
                        'hearts': 'hearts 2s ease-in-out infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                        'slideInUp': 'slideInUp 0.5s ease-out',
                        'fadeIn': 'fadeIn 0.3s ease-out',
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @keyframes float {
            0%,
            100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-10px);
            }
        }
        
        @keyframes hearts {
            0%,
            100% {
                transform: scale(1);
                opacity: 0.7;
            }
            50% {
                transform: scale(1.2);
                opacity: 1;
            }
        }
        
        @keyframes glow {
            0% {
                box-shadow: 0 0 20px rgba(236, 72, 153, 0.3);
            }
            100% {
                box-shadow: 0 0 30px rgba(236, 72, 153, 0.6);
            }
        }
        
        @keyframes slideInUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        
        html,
        body {
            width: 100%;
            height: 100%;
            overflow-x: hidden;
            position: relative;
        }
        
        .auth-card {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.95);
        }
        
        .couple-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        
        .couple-bg::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: float 20s infinite linear;
        }
        
        .content-wrapper {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            width: 100%;
        }
        
        .floating-heart {
            position: absolute;
            animation: hearts 3s ease-in-out infinite;
            z-index: 0;
        }
        
        .floating-heart:nth-child(1) {
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }
        
        .floating-heart:nth-child(2) {
            top: 20%;
            right: 15%;
            animation-delay: 0.5s;
        }
        
        .floating-heart:nth-child(3) {
            bottom: 20%;
            left: 20%;
            animation-delay: 1s;
        }
        
        .floating-heart:nth-child(4) {
            bottom: 15%;
            right: 10%;
            animation-delay: 1.5s;
        }
        
        @media (max-width: 640px) {
            .floating-heart {
                font-size: 1rem;
            }
        }
        
        .input-group {
            transition: all 0.3s ease;
        }
        
        .input-group:focus-within {
            transform: translateY(-2px);
        }
        
        .code-input {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        
        .code-input:focus {
            background: white;
            border-color: #ec4899;
            box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.1);
        }
        
        .step-indicator {
            transition: all 0.5s ease;
        }
        
        .step-indicator.active {
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            color: white;
            transform: scale(1.1);
        }
        
        .loading-dots::after {
            content: '';
            animation: loading 1.5s infinite;
        }
        
        @keyframes loading {
            0% {
                content: '';
            }
            33% {
                content: '.';
            }
            66% {
                content: '..';
            }
            100% {
                content: '...';
            }
        }
    </style>
</head>

<body class="font-sans">

    <!-- Fixed Background -->
    <div class="couple-bg">
        <!-- Floating Hearts Background -->
        <div class="floating-heart text-pink-300 text-2xl opacity-60">💕</div>
        <div class="floating-heart text-rose-300 text-xl opacity-50">💖</div>
        <div class="floating-heart text-purple-300 text-lg opacity-70">💝</div>
        <div class="floating-heart text-pink-400 text-xl opacity-60">💗</div>
    </div>

    <!-- Scrollable Content -->
    <div class="content-wrapper">
        <div class="min-h-screen flex items-center justify-center p-4 py-8">
            <div class="w-full max-w-md">

                <!-- App Logo & Title -->
                <div class="text-center mb-6 sm:mb-8 animate-slideInUp">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 bg-gradient-to-r from-pink-500 to-purple-500 rounded-3xl flex items-center justify-center mx-auto mb-3 sm:mb-4 animate-glow">
                        <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white animate-hearts" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">Couple App</h1>
                    <p class="text-white/80 text-xs sm:text-sm px-4">Ứng dụng quản lý tình yêu cho các cặp đôi</p>
                </div>

                <!-- Auth Card -->
                <div class="auth-card rounded-3xl shadow-2xl border border-white/20 p-6 sm:p-8 animate-slideInUp">

                    <!-- Step Indicator -->
                    <div class="flex justify-center space-x-3 sm:space-x-4 mb-6 sm:mb-8" id="step-indicators">
                        <div class="step-indicator active w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-xs sm:text-sm font-semibold bg-gray-200 text-gray-600">1</div>
                        <div class="w-8 sm:w-12 h-0.5 bg-gray-200 self-center"></div>
                        <div class="step-indicator w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-xs sm:text-sm font-semibold bg-gray-200 text-gray-600">2</div>
                        <div class="w-8 sm:w-12 h-0.5 bg-gray-200 self-center"></div>
                        <div class="step-indicator w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-xs sm:text-sm font-semibold bg-gray-200 text-gray-600">3</div>
                    </div>

                    <!-- Step 1: Welcome & Choice -->
                    <div id="step-1" class="space-y-4 sm:space-y-6">
                        <div class="text-center mb-4 sm:mb-6">
                            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-2">Chào mừng! 👋</h2>
                            <p class="text-sm sm:text-base text-gray-600">Bạn muốn bắt đầu như thế nào?</p>
                        </div>

                        <div class="space-y-3 sm:space-y-4">
                            <button onclick="selectChoice('create')" class="w-full p-4 sm:p-6 bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white rounded-2xl font-medium transition-all hover:scale-105 hover:shadow-xl">
                                <div class="flex items-center justify-center space-x-3">
                                    <span class="text-xl sm:text-2xl">💕</span>
                                    <div class="text-left">
                                        <div class="text-sm sm:text-base font-semibold">Tạo tài khoản mới</div>
                                        <div class="text-xs sm:text-sm text-pink-100">Tôi muốn tạo tài khoản couple đầu tiên</div>
                                    </div>
                                </div>
                            </button>

                            <button onclick="showLoginForm()" class="w-full p-4 sm:p-6 bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-white rounded-2xl font-medium transition-all hover:scale-105 hover:shadow-xl">
                                <div class="flex items-center justify-center space-x-3">
                                    <span class="text-xl sm:text-2xl">🔗</span>
                                    <div class="text-left">
                                        <div class="text-sm sm:text-base font-semibold">Đăng nhập tài khoản</div>
                                        <div class="text-xs sm:text-sm text-purple-100">Tìm kiếm người yêu cùng tôi nhé</div>
                                    </div>
                                </div>
                            </button>
                        </div>

                        <div class="text-center">
                            <button onclick="showFogotPasswordForm()" class="text-gray-600 hover:text-gray-800 text-xs sm:text-sm transition-colors">
                                Đã có tài khoản? <span class="font-medium underline">Quên mật khẩu</span>
                            </button>
                        </div>
                    </div>

                    <!-- Step 2: Personal Info -->
                    <div id="step-2" class="space-y-4 sm:space-y-6 hidden">
                        <div class="text-center mb-4 sm:mb-6">
                            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-2" id="step-2-title">Tạo hồ sơ cá nhân</h2>
                            <p class="text-sm sm:text-base text-gray-600" id="step-2-subtitle">Điền thông tin để bắt đầu</p>
                        </div>

                        <form id="personal-form" action="/register" method="POST" class="space-y-3 sm:space-y-4">
                            <div class="input-group">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Tên hiển thị</label>
                                <input type="text" name="displayName" id="display-name" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all" placeholder="VD: An, Minh...">
                            </div>

                            <div class="grid grid-cols-2 gap-3 sm:gap-4">
                                <div class="input-group">
                                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Sinh nhật</label>
                                    <input type="date" name="birthday" id="birthday" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all">
                                </div>
                                <div class="input-group">
                                    <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Giới tính</label>
                                    <select name="gender" id="gender" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all">
                                        <option value="">Chọn giới tính</option>
                                        <option value="Nữ">Nữ 👩</option>
                                        <option value="Nam">Nam 👨</option>
                                        <option value="Khác">Khác 👤</option>
                                    </select>
                                </div>
                            </div>

                            <div class="input-group">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input type="email" name="email" id="email" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all" placeholder="your@email.com">
                            </div>

                            <div class="input-group">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                                <input type="password" name="password" id="password" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all" placeholder="Tối thiểu 6 ký tự">
                            </div>

                            <div>
                                <p id="form-error" class="text-red-500 text-xs sm:text-sm"></p>
                            </div>

                            <div id="couple-code-section" class="input-group hidden">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Mã couple</label>
                                <input type="text" id="couple-code" class="code-input w-full p-3 sm:p-4 rounded-xl text-center text-base sm:text-lg font-mono font-bold tracking-wider uppercase focus:outline-none" placeholder="LOVE2024" maxlength="8">
                                <p class="text-xs sm:text-sm text-gray-500 mt-2 text-center">Nhập mã 8 ký tự mà người yêu đã chia sẻ</p>
                            </div>
                        </form>

                        <div class="flex space-x-2 sm:space-x-3">
                            <button onclick="goToStep(1)" class="px-4 sm:px-6 py-2.5 sm:py-3 text-sm sm:text-base border border-gray-300 rounded-xl text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                                ← Quay lại
                            </button>
                            <button type="submit" form="personal-form" id="submit-btn" class="flex-1 py-2.5 sm:py-3 px-4 sm:px-6 text-sm sm:text-base bg-gradient-to-r from-pink-500 to-purple-500 text-white rounded-xl font-medium hover:shadow-lg transition-all">
                                Tiếp tục →
                            </button>
                        </div>
                    </div>

                    <!-- Step 3: Couple Connection -->
                    <div id="step-3" class="space-y-4 sm:space-y-6 hidden">
                        <div class="text-center mb-4 sm:mb-6">
                            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-2">Kết nối đôi</h2>
                            <p class="text-sm sm:text-base text-gray-600">Tạo hoặc nhập mã để ghép cặp</p>
                        </div>

                        <!-- Create Couple Code -->
                        <div id="create-code-section" class="space-y-3 sm:space-y-4">
                            <div class="bg-gradient-to-br from-pink-50 to-purple-50 rounded-2xl p-4 sm:p-6 border border-pink-200">
                                <div class="text-center">
                                    <div class="text-xl sm:text-2xl mb-3 sm:mb-4 animate-float">💕</div>
                                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 mb-2">Mã couple của bạn</h3>
                                    <div class="bg-white rounded-xl p-3 sm:p-4 mb-3 sm:mb-4">
                                        <div class="text-2xl sm:text-3xl font-mono font-bold text-pink-600 tracking-wider" id="generated-code">LOVE2025</div>
                                    </div>
                                    <p class="text-xs sm:text-sm text-gray-600 mb-3 sm:mb-4">Chia sẻ mã này với người yêu để kết nối</p>
                                    <div class="flex space-x-2">
                                        <button onclick="copyCode()" class="flex-1 py-2 px-3 sm:px-4 text-xs sm:text-sm bg-white border border-pink-200 rounded-lg text-pink-600 font-medium hover:bg-pink-50 transition-colors">
                                            📋 Copy mã
                                        </button>
                                        <button onclick="shareCode()" class="flex-1 py-2 px-3 sm:px-4 text-xs sm:text-sm bg-pink-500 text-white rounded-lg font-medium hover:bg-pink-600 transition-colors">
                                            📤 Chia sẻ
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center">
                                <p class="text-xs sm:text-sm text-gray-500 mb-3 sm:mb-4">Chờ người yêu kết nối...</p>
                                <div class="loading-dots text-sm sm:text-base text-pink-500 font-semibold">Đang chờ</div>
                            </div>
                        </div>

                        <!-- Join with Code -->
                        <div id="join-code-section" class="space-y-3 sm:space-y-4 hidden">
                            <div class="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-2xl p-4 sm:p-6 border border-purple-200">
                                <div class="text-center">
                                    <div class="text-xl sm:text-2xl mb-3 sm:mb-4 animate-float">🔗</div>
                                    <h3 class="text-sm sm:text-base font-semibold text-gray-800 mb-3 sm:mb-4">Nhập mã couple</h3>
                                    <input type="text" id="join-couple-code" class="code-input w-full p-3 sm:p-4 rounded-xl text-center text-xl sm:text-2xl font-mono font-bold tracking-wider uppercase focus:outline-none mb-3 sm:mb-4" placeholder="LOVE2024" maxlength="8">
                                    <button onclick="joinCouple()" class="w-full py-2.5 sm:py-3 px-4 sm:px-6 text-sm sm:text-base bg-gradient-to-r from-purple-500 to-indigo-500 text-white rounded-xl font-medium hover:shadow-lg transition-all">
                                        🔗 Kết nối ngay
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Connection Status -->
                        <div id="connection-status" class="hidden">
                            <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-4 sm:p-6 border border-green-200 text-center">
                                <div class="text-2xl sm:text-3xl mb-3 sm:mb-4 animate-hearts">💚</div>
                                <h3 class="text-sm sm:text-base font-semibold text-gray-800 mb-2">Kết nối thành công!</h3>
                                <p class="text-xs sm:text-sm text-gray-600 mb-3 sm:mb-4">Chúc mừng! Bạn đã được ghép cặp thành công</p>
                                <button onclick="completeRegistration()" class="py-2.5 sm:py-3 px-4 sm:px-6 text-sm sm:text-base bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-xl font-medium hover:shadow-lg transition-all">
                                    Bắt đầu hành trình yêu 💕
                                </button>
                            </div>
                        </div>

                        <div class="flex space-x-2 sm:space-x-3">
                            <button onclick="goToStep(2)" class="px-4 sm:px-6 py-2.5 sm:py-3 text-sm sm:text-base border border-gray-300 rounded-xl text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                                ← Quay lại
                            </button>
                            <button onclick="skipConnection()" class="flex-1 py-2.5 sm:py-3 px-3 sm:px-6 text-sm sm:text-base border border-gray-300 rounded-xl text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                                Bỏ qua (kết nối sau)
                            </button>
                        </div>
                    </div>

                    <!-- Login Form -->
                    <form id="login-form" onsubmit="login(event)" class="space-y-4 sm:space-y-6 hidden">
                        <div class="text-center mb-4 sm:mb-6">
                            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-2">Đăng nhập</h2>
                            <p class="text-sm sm:text-base text-gray-600">Chào mừng trở lại!</p>
                        </div>

                        <div class="space-y-3 sm:space-y-4">
                            <div class="input-group">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input type="email" id="login-email" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all" placeholder="your@email.com">
                            </div>

                            <div class="input-group">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                                <input type="password" id="login-password" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all" placeholder="Mật khẩu của bạn">
                            </div>

                            <div>
                                <p id="login-error" class="text-red-500 text-xs sm:text-sm"></p>
                            </div>

                            <div class="flex items-center justify-between text-xs sm:text-sm">
                                <label class="flex items-center">
                                    <input type="checkbox" class="rounded border-gray-300 text-pink-500 focus:ring-pink-500">
                                    <span class="ml-2 text-gray-600">Ghi nhớ đăng nhập</span>
                                </label>
                                <button type="button" onclick="showFogotPasswordForm()" class="text-pink-600 hover:text-pink-700 font-medium">
                                    Quên mật khẩu?
                                </button>
                            </div>
                        </div>

                        <button type="submit" id="login-btn" class="w-full py-3 sm:py-4 text-sm sm:text-base bg-gradient-to-r from-pink-500 to-purple-500 text-white rounded-xl font-medium hover:shadow-lg transition-all">
                            Đăng nhập
                        </button>

                        <div class="text-center">
                            <button type="button" onclick="showRegister()" class="text-gray-600 hover:text-gray-800 text-xs sm:text-sm transition-colors">
                                Chưa có tài khoản? <span class="font-medium underline">Đăng ký ngay</span>
                            </button>
                        </div>
                    </form>

                    <!-- Fogot Password Form -->
                    <form id="fogot-password-form" onsubmit="fotgotPassword(event)" class="space-y-4 sm:space-y-6 hidden">
                        <div class="text-center mb-4 sm:mb-6">
                            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-2">Quên Mật Khẩu</h2>
                            <p class="text-sm sm:text-base text-gray-600">Chúc bạn vui vẻ!</p>
                        </div>

                        <div class="space-y-3 sm:space-y-4">
                            <div class="input-group">
                                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input type="email" id="forgot-email" class="w-full p-3 text-sm sm:text-base border border-gray-200 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-pink-500 transition-all" placeholder="your@email.com">
                            </div>

                            <div>
                                <p id="fogot-password-error" class="text-red-500 text-xs sm:text-sm"></p>
                            </div>

                            <div class="flex items-center justify-between text-xs sm:text-sm">
                                <label class="flex items-center">
                                    
                                </label>
                                <button type="button" onclick="showLoginForm()" class="text-pink-600 hover:text-pink-700 font-medium">
                                    Đăng nhập
                                </button>
                            </div>
                        </div>

                        <button type="submit" id="forgot-btn" class="w-full py-3 sm:py-4 text-sm sm:text-base bg-gradient-to-r from-pink-500 to-purple-500 text-white rounded-xl font-medium hover:shadow-lg transition-all">
                            Gửi mật khẩu mới
                        </button>

                        <div class="text-center">
                            <button type="button" onclick="showRegister()" class="text-gray-600 hover:text-gray-800 text-xs sm:text-sm transition-colors">
                                Chưa có tài khoản? <span class="font-medium underline">Đăng ký ngay</span>
                            </button>
                        </div>
                    </form>
