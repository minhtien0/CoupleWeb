                                                <% } else if (item.type === "Giải trí") { %>
                                                    🎬
                                                <% } else if (item.type === "Di chuyển") { %>
                                                    🚗
                                                <% } else if (item.type === "Mua sắm") { %>
                                                    🛍️
                                                <% } else if (item.type === "Du lịch") { %>
                                                    ✈️
                                                <% } else { %>
                                                    💳
                                                <% } %></span>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-800">
                                            <%= item.title %>
                                        </h4>
                                        <p class="text-sm text-gray-500">
                                            <%= formattedDate %> •
                                                <%= item.user_id === coupleInfo.user1_id ? coupleInfo.user1_name : coupleInfo.user2_name%> trả</p>
                                    </div>
                                </div>

                                <div class="text-right">
                                    <div class="font-semibold text-gray-800">
                                        <%= item.money.toLocaleString() %>₫</div>
                                    <div class="text-xs text-rose-600">+???₫</div>
                                </div>
                            </div>
                            <% }) %>

                                <% } else { %>

