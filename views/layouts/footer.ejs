    <div id="notification-list" class="max-h-96 overflow-y-auto p-4 space-y-3">
    </div>
    <div class="bg-rose-50 border-t border-rose-200 px-4 py-3 text-center">
        <a href="/notifications" class="text-rose-600 font-medium hover:text-rose-700">Xem tất cả thông báo →</a>
